<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.Color?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ServiceController"
            stylesheets="@style.css">

    <!-- ========== BARRE DE TITRE UNIQUE ========== -->
    <HBox style="-fx-background-color: #16325c; -fx-padding: 8 20; -fx-alignment: CENTER_RIGHT;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" prefHeight="45">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="AFTER Travel - Gestion des Services" style="-fx-text-fill: #F5F5DC; -fx-font-size: 15px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="8">
            <Button fx:id="minimizeButton" text="─" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
            <Button fx:id="maximizeButton" text="□" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
            <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <!-- ========== CONTENEUR PRINCIPAL ========== -->
    <BorderPane prefWidth="1300" prefHeight="750" AnchorPane.topAnchor="45" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ========== HEADER ========== -->
        <top>
            <VBox spacing="0">
                <StackPane prefHeight="80" style="-fx-background-color: linear-gradient(to right, #0A2F44, #16325c, #1e4a7a);">
                    <HBox alignment="CENTER" spacing="20">
                        <Circle radius="20" fill="#FFD700" opacity="0.3" />
                        <Circle radius="15" fill="#FFD700" opacity="0.5" />
                        <Label text="🏨" style="-fx-font-size: 40px;" />
                        <Label text="GESTION DES SERVICES" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />
                        <Label text="✨" style="-fx-font-size: 40px;" />
                        <Circle radius="15" fill="#FFD700" opacity="0.5" />
                        <Circle radius="20" fill="#FFD700" opacity="0.3" />
                    </HBox>
                </StackPane>

                <HBox style="-fx-background-color: #16325c; -fx-padding: 15 30; -fx-alignment: CENTER_LEFT;" spacing="20">
                    <Button text="← Retour au Tableau de Bord"
                            onAction="#handleDashboard"
                            style="-fx-background-color: #F5F5DC; -fx-text-fill: #16325c; -fx-padding: 10 25; -fx-background-radius: 25; -fx-font-weight: bold; -fx-cursor: hand;"
                            prefWidth="200"/>
                    <Label text="Services Premium" style="-fx-text-fill: #FFD700; -fx-font-size: 18px; -fx-font-style: italic;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="dateLabel" style="-fx-text-fill: #F5F5DC; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </top>

        <!-- ========== CONTENU PRINCIPAL ========== -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background: #F5F5DC; -fx-background-color: #F5F5DC; -fx-border: none;">
                <VBox spacing="25" style="-fx-padding: 25; -fx-background-color: #F5F5DC;">

                    <!-- ========== FORMULAIRE ========== -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 10; -fx-background-radius: 10;">
                                <Label text="➕" style="-fx-font-size: 24px; -fx-text-fill: white;" />
                            </StackPane>
                            <VBox>
                                <Label text="Ajouter / Modifier un Service" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                                <Label text="Gérez vos prestations de voyage" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                            </VBox>
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="100" />
                            </columnConstraints>

                            <Label text="Nom du service" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.rowIndex="0"/>
                            <TextField fx:id="nomField" promptText="Ex: Transport VIP, Guide touristique..."
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.rowIndex="1"/>

                            <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.rowIndex="2"/>
                            <TextField fx:id="descriptionField" promptText="Description détaillée..."
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.rowIndex="3"/>

                            <Label text="Catégorie" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.rowIndex="4"/>
                            <TextField fx:id="categorieField" promptText="Ex: Transport, Hébergement, Activité..."
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.rowIndex="5"/>
                        </GridPane>

                        <Separator style="-fx-background-color: #16325c;" />

                        <HBox spacing="20" alignment="CENTER">
                            <Button text="Ajouter" onAction="#ajouterService"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Modifier" onAction="#modifierService"
                                    style="-fx-background-color: #1e4a7a; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Supprimer" onAction="#supprimerService"
                                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Annuler" onAction="#annuler"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                        </HBox>
                    </VBox>

                    <!-- ========== RECHERCHE ========== -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                                <Label text="🔍" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                            </StackPane>
                            <Label text="Rechercher un service" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <HBox spacing="10">
                            <TextField fx:id="searchField" promptText="Nom, description, catégorie..." HBox.hgrow="ALWAYS"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-background-color: #F5F5DC;"/>
                            <Button text="🔍" onAction="#rechercherServices"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                            <Button text="🔄" onAction="#reinitialiserRecherche"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="resultatsCountLabel" text="0 service(s)"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #F5F5DC; -fx-padding: 8 15; -fx-background-radius: 20;"/>
                        </HBox>
                    </VBox>

                    <!-- ========== LISTE DES SERVICES ========== -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                                <Label text="📋" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                            </StackPane>
                            <Label text="Nos Services" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                            <Label fx:id="totalServicesLabel" text="(0 services)" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <ScrollPane fx:id="scrollPane" prefHeight="400" fitToWidth="true"
                                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border: none;">
                            <VBox fx:id="servicesVBox" spacing="15" style="-fx-padding: 10;"/>
                        </ScrollPane>

                        <HBox alignment="CENTER">
                            <Label text="✨ Cliquez sur 'Sélectionner' pour modifier un service ✨"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 13px; -fx-font-style: italic; -fx-background-color: #F5F5DC; -fx-padding: 8 20; -fx-background-radius: 30;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</AnchorPane>