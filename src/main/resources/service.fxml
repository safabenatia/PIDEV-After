<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ServiceController"
            stylesheets="@style.css">

    <!-- BARRE DE TITRE -->
    <HBox style="-fx-background-color: #16325c; -fx-padding: 8 15; -fx-alignment: CENTER_RIGHT;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" prefHeight="40">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="AFTER Travel - Gestion des Services" style="-fx-text-fill: #F5F5DC; -fx-font-size: 14px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="5">
            <Button fx:id="minimizeButton" text="─" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" />
            <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <BorderPane prefWidth="1100" prefHeight="650" AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- HEADER -->
        <top>
            <VBox>
                <!-- Header principal -->
                <HBox style="-fx-background-color: #16325c; -fx-padding: 16 24; -fx-alignment: CENTER_LEFT;" spacing="15">
                    <Button text="← Retour au Dashboard"
                            onAction="#handleDashboard"
                            style="-fx-background-color: #F5F5DC; -fx-text-fill: #16325c; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;"
                            prefWidth="200"/>
                    <Label text="Gestion des Services" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F5F5DC;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="🏨" style="-fx-font-size: 32px;" />
                </HBox>
            </VBox>
        </top>

        <!-- CONTENU PRINCIPAL -->
        <center>
            <HBox spacing="25" alignment="CENTER" style="-fx-padding:30; -fx-background-color: #F5F5DC;">

                <!-- FORMULAIRE à gauche -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1;" prefWidth="400" maxHeight="400">
                    <Label text="Ajouter / Modifier un Service" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>

                    <TextField fx:id="nomField"
                               promptText="Nom du service"
                               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #16325c; -fx-border-radius: 5;"/>

                    <TextField fx:id="descriptionField"
                               promptText="Description"
                               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #16325c; -fx-border-radius: 5;"/>

                    <TextField fx:id="categorieField"
                               promptText="Catégorie"
                               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #16325c; -fx-border-radius: 5;"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Ajouter"
                                onAction="#ajouterService"
                                style="-fx-background-color: #16325c; -fx-text-fill: #F5F5DC; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                                prefWidth="90"/>

                        <Button text="Modifier"
                                onAction="#modifierService"
                                style="-fx-background-color: #16325c; -fx-text-fill: #F5F5DC; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                                prefWidth="90"/>

                        <Button text="Supprimer"
                                onAction="#supprimerService"
                                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                                prefWidth="90"/>

                        <Button text="Annuler"
                                onAction="#annuler"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                                prefWidth="90"/>
                    </HBox>
                </VBox>

                <!-- LISTE DES SERVICES à droite -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1;" prefWidth="500" maxHeight="500">
                    <Label text="Liste des Services" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>

                    <ScrollPane fx:id="scrollPane" prefHeight="400" fitToWidth="true" style="-fx-background: white; -fx-background-color: white; -fx-border-color: #16325c; -fx-border-radius: 5;">
                        <VBox fx:id="servicesVBox" spacing="15" style="-fx-padding: 10;">
                            <!-- Les cartes seront ajoutées dynamiquement -->
                        </VBox>
                    </ScrollPane>

                    <Label text="Cliquez sur 'Sélectionner' pour modifier un service"
                           style="-fx-text-fill: #16325c; -fx-font-size: 12px; -fx-font-style: italic;"/>
                </VBox>

            </HBox>
        </center>

    </BorderPane>
</AnchorPane>