<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #F5F5DC;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.CategorieControllerV2">

    <children>
        <VBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
              style="-fx-background-color: #16325c; -fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: #F5F5DC;" text="✈" />
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="AFTER Travel - ADMIN" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #F5F5DC;" text="Gestion des Catégories" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="20" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="90.0">
            <children>

                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="📝 Informations de la Catégorie" />

                        <VBox spacing="8">
                            <children>
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Nom de la catégorie *" />
                                <TextField fx:id="nomField" promptText="Ex: Transport, Restaurant..."
                                           style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" />
                            </children>
                        </VBox>

                        <HBox alignment="BOTTOM_LEFT" spacing="10">
                            <children>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Icône (Image)" />
                                        <TextField fx:id="iconeField" promptText="Chemin de l'image..."
                                                   style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" />
                                    </children>
                                </VBox>
                                <Button fx:id="parcourirBtn" prefHeight="45.0" style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="📁 Parcourir...">
                                    <padding><Insets left="25.0" right="25.0" /></padding>
                                </Button>
                            </children>
                        </HBox>

                        <VBox spacing="8">
                            <children>
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Description" />
                                <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Décrivez cette catégorie..."
                                          style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" />
                            </children>
                        </VBox>

                        <HBox spacing="15">
                            <children>
                                <Button fx:id="ajouterBtn" style="-fx-background-color: #FFD700; -fx-text-fill: #16325c; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Ajouter la catégorie" />
                                <Button fx:id="annulerBtn" style="-fx-background-color: #cccccc; -fx-text-fill: #16325c; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Réinitialiser" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <children>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="📂 Liste des Catégories" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="countLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c; -fx-background-color: white; -fx-padding: 10 20; -fx-background-radius: 8;" text="Total: 0 catégories" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="categoriesContainer" spacing="10" style="-fx-padding: 5;" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>