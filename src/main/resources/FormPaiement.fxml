<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.FormPaiementController"
            style="-fx-background-color: #FEFAF6;">

    <VBox spacing="0" alignment="CENTER" maxWidth="460"
          style="-fx-background-color: white;
                 -fx-background-radius: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 30, 0, 0, 15);
                 -fx-border-color: #A7927722;
                 -fx-border-radius: 20;">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="8"
              style="-fx-background-color: #005082;
                     -fx-background-radius: 18 18 0 0;
                     -fx-padding: 30 40 25 40;">
            <Label text="💳" style="-fx-font-size: 36px;"/>
            <Label fx:id="lblTitre" text="Effectuer un paiement"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Sécurisez votre réservation"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);"/>
        </VBox>

        <!-- FORM BODY -->
        <VBox spacing="18" style="-fx-padding: 35 45 35 45;">

            <VBox spacing="6">
                <Label text="Référence" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="tfReference" promptText="PAY-..." style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Montant" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfMontant" promptText="0.00" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Devise" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfDevise" promptText="TND" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Méthode" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbMethode" maxWidth="Infinity" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Statut" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbStatut" maxWidth="Infinity" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Réservation #" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="tfIdReservation" promptText="ID" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Date" style="-fx-text-fill: #005082; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpDate" maxWidth="Infinity" style="-fx-background-color: #FEFAF6; -fx-border-color: #A7927744; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                </VBox>
            </HBox>

            <HBox spacing="15" style="-fx-padding: 15 0 0 0;">
                <Button text="Annuler" onAction="#annuler" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #A79277; 
                               -fx-border-color: #A79277; -fx-border-radius: 12; -fx-padding: 12; -fx-cursor: hand;"/>
                <Button text="Enregistrer" onAction="#enregistrer" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #0081C9; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- TOAST OVERLAY -->
    <StackPane fx:id="notifOverlay" alignment="BOTTOM_CENTER"
               mouseTransparent="true" style="-fx-padding: 0 0 24 0;"/>
</StackPane>
