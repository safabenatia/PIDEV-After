<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="tn.esprit.controllers.MenuController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #F5F5DC;">
    
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color: #16325c; -fx-padding: 30;">
        
        <VBox alignment="CENTER" spacing="10">
            <Label text="✈" style="-fx-font-size: 48px; -fx-text-fill: #FFD700;"/>
            <Label text="AFTER Travel" 
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Plateforme de Gestion de Voyages" 
                   style="-fx-font-size: 18px; -fx-text-fill: #F5F5DC; -fx-font-style: italic;"/>
        </VBox>
    </VBox>
    
    <VBox spacing="40" alignment="CENTER"
          AnchorPane.topAnchor="180.0" 
          AnchorPane.leftAnchor="100.0" 
          AnchorPane.rightAnchor="100.0"
          AnchorPane.bottomAnchor="80.0">
        
        <Label text="Choisissez votre espace" 
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
        
        <HBox spacing="40" alignment="CENTER">
            
            <VBox spacing="20" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 40 30; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
                    <Label text="👤" style="-fx-font-size: 64px;"/>
                    <Label text="Espace Utilisateur" 
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                    <Label text="Gérez vos dépenses de voyage" 
                           style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-text-alignment: center;" 
                           wrapText="true" prefWidth="220"/>
                </VBox>
                
                <Button fx:id="btnDepenses" text="📊 Accéder aux Dépenses" 
                        style="-fx-background-color: #FFD700; -fx-text-fill: #16325c; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 10; -fx-cursor: hand;"
                        prefWidth="250"/>
                
                <VBox spacing="5" alignment="CENTER">
                    <Label text="✓ Ajouter des dépenses" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label text="✓ Voir l'historique" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label text="✓ Calculer le total" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                </VBox>
            </VBox>
            
            <VBox spacing="20" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 40 30; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
                    <Label text="👨‍💼" style="-fx-font-size: 64px;"/>
                    <Label text="Espace Administrateur" 
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                    <Label text="Gérez les catégories de dépenses" 
                           style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-text-alignment: center;" 
                           wrapText="true" prefWidth="220"/>
                </VBox>
                
                <Button fx:id="btnCategories" text="⚙️ Accéder aux Catégories" 
                        style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-background-radius: 10; -fx-cursor: hand;"
                        prefWidth="250"/>
                
                <VBox spacing="5" alignment="CENTER">
                    <Label text="✓ Créer des catégories" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label text="✓ Modifier les catégories" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label text="✓ Gérer les icônes" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                </VBox>
            </VBox>
            
        </HBox>
    </VBox>
    
    <HBox alignment="CENTER" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Label text="© 2026 AFTER Travel - Tous droits réservés" 
               style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
    </HBox>
    
</AnchorPane>
