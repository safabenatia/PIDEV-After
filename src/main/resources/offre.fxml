<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OffreController">
    <children>
        <!-- Champ pour le titre de l'offre -->
        <TextField fx:id="TitreOffreField" layoutX="221.0" layoutY="63.0" promptText="Titre de l'Offre" />

        <!-- Champ pour le prix de l'offre -->
        <TextField fx:id="PrixOffreField" layoutX="223.0" layoutY="131.0" promptText="Prix" />

        <!-- Champ pour la durée de l'offre -->
        <TextField fx:id="DureeOffreField" layoutX="221.0" layoutY="200.0" promptText="Durée (en jours)" />

        <!-- Champ pour l'id du service lié à l'offre -->
        <TextField fx:id="ServiceIdOffreField" layoutX="221.0" layoutY="270.0" promptText="ID du Service" />

        <!-- Bouton pour ajouter l'offre -->
        <Button layoutX="252.0" layoutY="340.0" mnemonicParsing="false" onAction="#AddOffre" text="Ajouter Offre" />
        <ComboBox fx:id="serviceCombo" />

    </children>
</AnchorPane>
