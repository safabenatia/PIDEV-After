<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreController"
            stylesheets="@style.css">

    <BorderPane prefWidth="1200" prefHeight="700">

        <!-- HEADER -->
        <top>
            <VBox>
                <!-- Bannière thématique -->
                <HBox styleClass="theme-banner" alignment="CENTER" spacing="10" prefHeight="40">
                    <Label text="✈️" style="-fx-font-size: 20px;" />
                    <Label text="After Travel - Gestion des Offres" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Label text="🏷️" style="-fx-font-size: 20px;" />
                </HBox>

                <!-- Header principal -->
                <HBox styleClass="main-header" spacing="15" alignment="CENTER_LEFT">
                    <Button text="← Retour au Dashboard"
                            onAction="#handleDashboard"
                            styleClass="btn-secondary"
                            prefWidth="200"/>
                    <Label text="Gestion des Offres" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="🏷️" style="-fx-font-size: 32px; -fx-text-fill: #0B4F6C;" />
                </HBox>
            </VBox>
        </top>

        <!-- CONTENU PRINCIPAL -->
        <center>
            <VBox spacing="25" alignment="TOP_CENTER" style="-fx-padding:30;">

                <!-- FORMULAIRE -->
                <VBox spacing="15" styleClass="stats-container" prefWidth="600">
                    <Label text="Ajouter / Modifier une Offre" styleClass="stats-label"/>

                    <TextField fx:id="TitreOffreField"
                               promptText="Titre de l'offre"
                               styleClass="text-field"/>

                    <TextField fx:id="PrixOffreField"
                               promptText="Prix (DT)"
                               styleClass="text-field"/>

                    <TextField fx:id="DureeOffreField"
                               promptText="Durée (en jours)"
                               styleClass="text-field"/>

                    <ComboBox fx:id="serviceCombo"
                              promptText="Sélectionner un service"
                              styleClass="combo-box"/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="Ajouter"
                                onAction="#ajouterOffre"
                                styleClass="btn-success"/>

                        <Button text="Modifier"
                                onAction="#modifierOffre"
                                styleClass="btn-edit"/>

                        <Button text="Supprimer"
                                onAction="#supprimerOffre"
                                styleClass="btn-delete"/>

                        <Button text="Annuler"
                                onAction="#annuler"
                                styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <!-- TABLE -->
                <VBox spacing="10" styleClass="stats-container" prefWidth="1050">
                    <Label text="Liste des Offres" styleClass="stats-label"/>

                    <TableView fx:id="tableOffres" styleClass="table-view">
                        <columns>
                            <TableColumn text="ID" fx:id="colId" prefWidth="60"/>
                            <TableColumn text="Titre" fx:id="colTitre" prefWidth="250"/>
                            <TableColumn text="Prix" fx:id="colPrix" prefWidth="100"/>
                            <TableColumn text="Durée" fx:id="colDuree" prefWidth="100"/>
                            <TableColumn text="Service" fx:id="colService" prefWidth="250"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </center>

    </BorderPane>
</AnchorPane>