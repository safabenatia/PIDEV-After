<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreController"
            stylesheets="@style.css">

    <!-- BARRE DE TITRE -->
    <HBox style="-fx-background-color: #16325c; -fx-padding: 8 20; -fx-alignment: CENTER_RIGHT;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" prefHeight="45">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="AFTER Travel - Gestion des Offres" style="-fx-text-fill: #F5F5DC; -fx-font-size: 15px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="8">
            <Button fx:id="minimizeButton" text="─" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
            <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <BorderPane prefWidth="1300" prefHeight="750" AnchorPane.topAnchor="45" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" style="-fx-background-color: #F5F5DC;">

        <!-- HEADER -->
        <top>
            <HBox style="-fx-background-color: #16325c; -fx-padding: 15 30; -fx-alignment: CENTER_LEFT;" spacing="20">
                <Button text="← Retour au Dashboard" onAction="#handleDashboard" style="-fx-background-color: #F5F5DC; -fx-text-fill: #16325c; -fx-padding: 10 25; -fx-background-radius: 25; -fx-font-weight: bold; -fx-cursor: hand;" prefWidth="200"/>
                <Label text="Gestion des Offres" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F5F5DC;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="🏷️" style="-fx-font-size: 40px;" />
            </HBox>
        </top>

        <!-- CONTENU PRINCIPAL -->
        <center>
            <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20;">

                <!-- FORMULAIRE -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10;" prefWidth="600">
                    <Label text="Ajouter / Modifier une Offre" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                    <Separator />
                    <TextField fx:id="TitreOffreField" promptText="Titre" />
                    <TextField fx:id="PrixOffreField" promptText="Prix (DT)" />
                    <TextField fx:id="DureeOffreField" promptText="Durée (jours)" />
                    <ComboBox fx:id="serviceCombo" promptText="Service" />
                    <HBox spacing="5">
                        <Button text="Ajouter" onAction="#ajouterOffre" />
                        <Button text="Modifier" onAction="#modifierOffre" />
                        <Button text="Supprimer" onAction="#supprimerOffre" />
                        <Button text="Annuler" onAction="#annuler" />
                    </HBox>
                </VBox>

                <!-- SECTION RECHERCHE (NOUVEAU) -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10;" prefWidth="900">
                    <Label text="🔍 Rechercher une offre" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>

                    <HBox spacing="10">
                        <TextField fx:id="searchField" promptText="Titre, service..." HBox.hgrow="ALWAYS"
                                   style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #16325c;"/>
                        <Button text="Rechercher" onAction="#rechercherOffres"
                                style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                        <Button text="Réinitialiser" onAction="#reinitialiserRecherche"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 5;"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Prix entre:" style="-fx-text-fill: #16325c;"/>
                        <TextField fx:id="prixMinField" promptText="Min" prefWidth="60"
                                   style="-fx-padding: 5; -fx-background-radius: 5; -fx-border-color: #16325c;"/>
                        <Label text="-" />
                        <TextField fx:id="prixMaxField" promptText="Max" prefWidth="60"
                                   style="-fx-padding: 5; -fx-background-radius: 5; -fx-border-color: #16325c;"/>
                        <Label fx:id="resultatsCountLabel" text="0 offres" style="-fx-text-fill: #666; -fx-padding: 0 10;"/>
                    </HBox>
                </VBox>

                <!-- LISTE -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10;" prefWidth="900">
                    <Label text="Liste des Offres" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                    <Separator />
                    <ScrollPane fx:id="scrollPane" prefHeight="300">
                        <VBox fx:id="offresVBox" spacing="5" />
                    </ScrollPane>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>