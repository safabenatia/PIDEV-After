<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.paint.Color?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreController"
            stylesheets="@style.css">

    <!-- ========== BARRE DE TITRE UNIQUE ========== -->
    <HBox style="-fx-background-color: #16325c; -fx-padding: 8 20; -fx-alignment: CENTER_RIGHT;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" prefHeight="45">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="AFTER Travel - Gestion des Offres" style="-fx-text-fill: #F5F5DC; -fx-font-size: 15px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="8">
            <Button fx:id="minimizeButton" text="─" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
            <Button fx:id="maximizeButton" text="□" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
            <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <!-- ========== CONTENEUR PRINCIPAL ========== -->
    <BorderPane prefWidth="1300" prefHeight="750" AnchorPane.topAnchor="45" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ========== HEADER AVEC DÉGRADÉ ========== -->
        <top>
            <VBox spacing="0">
                <!-- Bannière supérieure -->
                <StackPane prefHeight="80" style="-fx-background-color: linear-gradient(to right, #0A2F44, #16325c, #1e4a7a);">
                    <HBox alignment="CENTER" spacing="20">
                        <Circle radius="20" fill="#FFD700" opacity="0.3" />
                        <Circle radius="15" fill="#FFD700" opacity="0.5" />
                        <Label text="✈️" style="-fx-font-size: 40px;" />
                        <Label text="GESTION DES OFFRES" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Montserrat';" />
                        <Label text="🌍" style="-fx-font-size: 40px;" />
                        <Circle radius="15" fill="#FFD700" opacity="0.5" />
                        <Circle radius="20" fill="#FFD700" opacity="0.3" />
                    </HBox>
                </StackPane>

                <!-- Barre de navigation secondaire -->
                <HBox style="-fx-background-color: #16325c; -fx-padding: 15 30; -fx-alignment: CENTER_LEFT;" spacing="20">
                    <Button text="← Retour au Tableau de Bord"
                            onAction="#handleDashboard"
                            style="-fx-background-color: #F5F5DC; -fx-text-fill: #16325c; -fx-padding: 10 25; -fx-background-radius: 25; -fx-font-weight: bold; -fx-cursor: hand;"
                            prefWidth="200"/>
                    <Label text="Offres Exceptionnelles" style="-fx-text-fill: #FFD700; -fx-font-size: 18px; -fx-font-style: italic;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="dateLabel" style="-fx-text-fill: #F5F5DC; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </top>

        <!-- ========== CONTENU PRINCIPAL ========== -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background: #F5F5DC; -fx-background-color: #F5F5DC; -fx-border: none;">
                <VBox spacing="25" style="-fx-padding: 25; -fx-background-color: #F5F5DC;">

                    <!-- ========== SECTION FORMULAIRE ========== -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 10; -fx-background-radius: 10;">
                                <Label text="✍️" style="-fx-font-size: 24px; -fx-text-fill: white;" />
                            </StackPane>
                            <VBox>
                                <Label text="Ajouter / Modifier une Offre" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                                <Label text="Créez des offres exceptionnelles pour vos clients" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                            </VBox>
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>

                            <!-- Ligne 1 : Titre -->
                            <Label text="Titre de l'offre" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                            <TextField fx:id="TitreOffreField" promptText="Ex: Séjour de rêve à Djerba"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>

                            <!-- Ligne 2 : Prix et Durée -->
                            <Label text="Prix (DT)" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Durée (jours)" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <TextField fx:id="PrixOffreField" promptText="500"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="DureeOffreField" promptText="7"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <!-- Ligne 3 : Service -->
                            <Label text="Service associé" style="-fx-font-weight: bold; -fx-text-fill: #16325c;" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                            <ComboBox fx:id="serviceCombo" promptText="Choisir un service"
                                      style="-fx-padding: 8; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC; -fx-pref-width: 300px;"
                                      GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
                        </GridPane>

                        <Separator style="-fx-background-color: #16325c;" />

                        <!-- Boutons CRUD et Météo -->
                        <HBox spacing="20" alignment="CENTER">
                            <Button text="Ajouter" onAction="#ajouterOffre"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Modifier" onAction="#modifierOffre"
                                    style="-fx-background-color: #1e4a7a; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Supprimer" onAction="#supprimerOffre"
                                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                            <Button text="Annuler" onAction="#annuler"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="120"/>
                        </HBox>

                        <!-- Boutons Météo -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="🌦️ Suggérer offre météo" onAction="#suggererOffreMeteo"
                                    style="-fx-background-color: #00bcd4; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="220"/>
                            <Button text="🌍 Voir la météo" onAction="#afficherMeteo"
                                    style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="180"/>
                        </HBox>
                    </VBox>

                    <!-- ========== SECTION RECHERCHE AVANCÉE ========== -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                                <Label text="🔍" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                            </StackPane>
                            <Label text="Recherche intelligente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                            <Label text="(filtres en temps réel)" style="-fx-text-fill: #666; -fx-font-size: 12px; -fx-font-style: italic;" />
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="70" />
                                <ColumnConstraints percentWidth="30" />
                            </columnConstraints>

                            <!-- Barre de recherche principale -->
                            <TextField fx:id="searchField" promptText="Rechercher par titre, service..."
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"
                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Button text="🔍" onAction="#rechercherOffres"
                                        style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="60"/>
                                <Button text="🔄" onAction="#reinitialiserRecherche"
                                        style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="60"/>
                            </HBox>

                            <!-- Filtres avancés -->
                            <HBox spacing="15" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <VBox spacing="3">
                                    <Label text="Prix min" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="prixMinField" promptText="Min" prefWidth="80"
                                               style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label text="Prix max" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="prixMaxField" promptText="Max" prefWidth="80"
                                               style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label text="Trier par" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <ComboBox fx:id="triCombo" prefWidth="120"
                                              style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;">
                                        <String fx:value="Pertinence"/>
                                        <String fx:value="Prix ↑"/>
                                        <String fx:value="Prix ↓"/>
                                        <String fx:value="Durée ↑"/>
                                        <String fx:value="Durée ↓"/>
                                    </ComboBox>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="resultatsCountLabel" text="0 offre(s)"
                                       style="-fx-text-fill: #16325c; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #F5F5DC; -fx-padding: 8 15; -fx-background-radius: 20;"/>
                            </HBox>
                        </GridPane>
                    </VBox>

                    <!-- ========== LISTE DES OFFRES ========== -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                                <Label text="📋" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                            </StackPane>
                            <Label text="Nos Offres Exceptionnelles" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                            <Label fx:id="totalOffresLabel" text="(0 offres)" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                        </HBox>

                        <Separator style="-fx-background-color: #16325c;" />

                        <ScrollPane fx:id="scrollPane" prefHeight="400" fitToWidth="true"
                                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border: none;">
                            <VBox fx:id="offresVBox" spacing="15" style="-fx-padding: 10;"/>
                        </ScrollPane>

                        <HBox alignment="CENTER">
                            <Label text="✨ Cliquez sur 'Sélectionner' pour modifier une offre ✨"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 13px; -fx-font-style: italic; -fx-background-color: #F5F5DC; -fx-padding: 8 20; -fx-background-radius: 30;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</AnchorPane>