<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="controllers.DashboardController"
            xmlns:fx="http://javafx.com/fxml">

    <left>
        <VBox spacing="15" style="-fx-background-color:#2c3e50; -fx-padding:20;">
            <Label text="Dashboard" style="-fx-text-fill:white; -fx-font-size:18;" />
            <Button text="Gestion Services" onAction="#openService"/>
            <Button text="Gestion Offres" onAction="#openOffre"/>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentArea"/>
    </center>

</BorderPane>
