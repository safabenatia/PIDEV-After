<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">

    <!-- BARRE DE TITRE PERSONNALISÉE - Toujours visible -->
    <HBox style="-fx-background-color: #16325c; -fx-padding: 8 20; -fx-alignment: CENTER_RIGHT;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" prefHeight="40">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="AFTER Travel - Dashboard" style="-fx-text-fill: #F5F5DC; -fx-font-size: 14px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="5">
            <Button fx:id="minimizeButton" text="─" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" />
            <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <!-- Conteneur principal (sans hauteur fixe) -->
    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.topAnchor="50" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" style="-fx-background-color: #F5F5DC;">

        <!-- Logo AFTER Travel -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="✈️" style="-fx-font-size: 40px;" />
            <Label text="AFTER Travel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
        </HBox>

        <!-- Message de bienvenue -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #16325c; -fx-padding: 15 20; -fx-background-radius: 8;">
            <Label text="Bienvenue sur After Travel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F5F5DC;" />
            <Label text="Votre plateforme de gestion de voyages" style="-fx-font-size: 14px; -fx-text-fill: #F5F5DC;" />
        </VBox>

        <!-- Statistiques -->
        <HBox spacing="30" alignment="CENTER">
            <!-- Services -->
            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-width: 2;">
                <Label text="🏨" style="-fx-font-size: 40px;" />
                <Label text="Services" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                <Label fx:id="totalServices" text="16" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                <Label text="prestations disponibles" style="-fx-font-size: 11px; -fx-text-fill: #666;" />
            </VBox>

            <!-- Offres -->
            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-width: 2;">
                <Label text="🏷️" style="-fx-font-size: 40px;" />
                <Label text="Offres" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                <Label fx:id="totalOffres" text="3" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                <Label text="promotions actives" style="-fx-font-size: 11px; -fx-text-fill: #666;" />
            </VBox>
        </HBox>

        <!-- Section Gestion de contenu -->
        <VBox spacing="15" alignment="CENTER" style="-fx-background-color: #16325c; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="Gestion de contenu" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F5F5DC;" />

            <HBox spacing="30" alignment="CENTER">
                <!-- Carte Services -->
                <VBox style="-fx-background-color: #F5F5DC; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-width: 2;" alignment="CENTER" spacing="10" prefWidth="250" onMouseClicked="#handleServices">
                    <Label text="🏨" style="-fx-font-size: 50px;" />
                    <Label text="Gestion des Services" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                    <Label text="Gérer vos prestations" style="-fx-font-size: 12px; -fx-text-fill: #666;" wrapText="true"/>
                    <Button text="Accéder →" style="-fx-background-color: #16325c; -fx-text-fill: #F5F5DC; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;" />
                </VBox>

                <!-- Carte Offres -->
                <VBox style="-fx-background-color: #F5F5DC; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-width: 2;" alignment="CENTER" spacing="10" prefWidth="250" onMouseClicked="#handleOffres">
                    <Label text="🏷️" style="-fx-font-size: 50px;" />
                    <Label text="Gestion des Offres" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                    <Label text="Créez des promotions" style="-fx-font-size: 12px; -fx-text-fill: #666;" wrapText="true"/>
                    <Button text="Accéder →" style="-fx-background-color: #16325c; -fx-text-fill: #F5F5DC; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #16325c; -fx-padding: 8 15; -fx-background-radius: 5;">
            <Label text="© 2026 After Travel" style="-fx-text-fill: #F5F5DC; -fx-font-size: 11px;" />
            <Label text="•" style="-fx-text-fill: #F5F5DC;" />
            <Label text="Équipe After" style="-fx-text-fill: #F5F5DC; -fx-font-size: 11px;" />
        </HBox>

    </VBox>

</AnchorPane>