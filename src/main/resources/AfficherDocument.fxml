<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherDocumentController">

    <!-- ================= NAVBAR ================= -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-background-color:#1e3c72; -fx-padding:15;">

            <Label text="✈ AFTER Travel"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtSearch"
                       promptText="Rechercher document..."
                       style="-fx-background-radius:20; -fx-padding:8 15; -fx-pref-width:250;"/>

            <Button text="📂"
                    onAction="#ouvrirCategories"
                    style="-fx-background-color:white; -fx-background-radius:20;"/>

            <Button text="+ Ajouter"
                    onAction="#ouvrirAjout"
                    style="-fx-background-color:#4CAF50;
                           -fx-text-fill:white;
                           -fx-background-radius:20;"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="containerDocuments"
                  spacing="20"
                  alignment="TOP_CENTER"
                  style="-fx-padding:30; -fx-background-color:#f4f6f9;"/>
        </ScrollPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color:#1e3c72; -fx-padding:10;">
            <Label text="© 2026 AFTER Travel - Gestion Documents Voyage"
                   style="-fx-text-fill:white;"/>
        </HBox>
    </bottom>

</BorderPane>