<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterServiceController">
    <children>
        <!-- Champ pour le nom du service -->
        <TextField fx:id="NomServiceField" layoutX="221.0" layoutY="63.0" promptText="Nom du Service">
         <padding>
            <Insets right="20.0" />
         </padding></TextField>

        <!-- Champ pour la description du service -->
        <TextField fx:id="DescriptionServiceField" layoutX="223.0" layoutY="131.0" promptText="Description" />

        <!-- Champ pour la catégorie du service -->
        <TextField fx:id="CategorieServiceField" layoutX="221.0" layoutY="200.0" promptText="Catégorie" />

        <!-- Bouton pour ajouter le service -->
        <Button layoutX="252.0" layoutY="271.0" mnemonicParsing="false" onAction="#AddService" text="Ajouter Service" />
    </children>
</AnchorPane>
