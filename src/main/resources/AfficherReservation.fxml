<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.AfficherReservationController"
            fitToWidth="true"
            style="-fx-background: transparent;">

    <VBox fx:id="mainContainer"
          spacing="20"
          alignment="TOP_CENTER"
          style="-fx-background-image: url('/images/plane.jpg');
                 -fx-background-size: cover;
                 -fx-background-position: center center;
                 -fx-padding: 20;">

        <!-- TITRE -->
        <Label text="RÉSERVATIONS"
               style="-fx-font-size: 36px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <!-- SOUS-TITRE -->
        <Label text="Liste des réservations"
               style="-fx-font-size: 24px;
                      -fx-text-fill: white;"/>

        <!-- Conteneur pour les réservations -->
        <VBox fx:id="reservationsContainer" spacing="10" alignment="TOP_CENTER"/>

    </VBox>
</ScrollPane>
