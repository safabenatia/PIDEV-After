<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreController"
            stylesheets="@style.css"
            style="-fx-background-color: #F5F5DC;">

    <top>
        <HBox style="-fx-background-color: #16325c; -fx-padding: 8 25; -fx-alignment: CENTER_LEFT;" prefHeight="50">
            <Label text="AFTER Travel - Gestion des Offres"
                   style="-fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10">
                <Button fx:id="minimizeButton" text="─"
                        style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 18px; -fx-cursor: hand;" />
                <Button fx:id="closeButton" text="✕"
                        style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 18px; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="20"
              style="-fx-background-color: #1e3a5f; -fx-padding: 32 16 32 16; -fx-min-width: 200;">
            <Label text="After Travel"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
            <VBox spacing="12">
                <Label text="👤 Mon Profil"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleRetourProfil" />
                <Separator style="-fx-background-color: rgba(255,255,255,0.2);" />
                <Label text="🗺️ Voyages &amp; Destinations"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleVoyages" />
                <Label text="🏨 Services &amp; Offres"
                       style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
                       onMouseClicked="#handleDashboard" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🚪 Déconnexion"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 8;"
                    onAction="#handleLogout" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F5F5DC; -fx-background-color: #F5F5DC; -fx-border: none;">
            <VBox spacing="25" style="-fx-padding: 25; -fx-background-color: #F5F5DC;">

                <StackPane prefHeight="80"
                           style="-fx-background-color: linear-gradient(to right, #0A2F44, #16325c, #1e4a7a); -fx-background-radius: 12;">
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="🏷️" style="-fx-font-size: 40px;" />
                        <Label text="GESTION DES OFFRES"
                               style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
                        <Label text="✨" style="-fx-font-size: 40px;" />
                    </HBox>
                </StackPane>

                <!-- FORMULAIRE -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane style="-fx-background-color: #16325c; -fx-padding: 10; -fx-background-radius: 10;">
                            <Label text="✍️" style="-fx-font-size: 24px; -fx-text-fill: white;" />
                        </StackPane>
                        <VBox>
                            <Label text="Ajouter / Modifier une Offre"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                            <Label text="Créez des offres exceptionnelles"
                                   style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>
                    <Separator style="-fx-background-color: #16325c;" />
                    <VBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Titre de l'offre" style="-fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                            <TextField fx:id="TitreOffreField" promptText="Ex: Séjour de rêve à Djerba"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"/>
                        </VBox>
                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Prix (DT)" style="-fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                                <TextField fx:id="PrixOffreField" promptText="500"
                                           style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Durée (jours)" style="-fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                                <TextField fx:id="DureeOffreField" promptText="7"
                                           style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="5">
                            <Label text="Service associé" style="-fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                            <ComboBox fx:id="serviceCombo" promptText="Choisir un service"
                                      style="-fx-padding: 8; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-color: #F5F5DC;"/>
                        </VBox>
                    </VBox>
                    <Separator style="-fx-background-color: #16325c;" />
                    <HBox spacing="15" alignment="CENTER">
                        <Button text="Ajouter" onAction="#ajouterOffre"
                                style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="100"/>
                        <Button text="Modifier" onAction="#modifierOffre"
                                style="-fx-background-color: #1e4a7a; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="100"/>
                        <Button text="Supprimer" onAction="#supprimerOffre"
                                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="100"/>
                        <Button text="Annuler" onAction="#annuler"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="100"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER">
                        <Button text="🌦️ Suggérer offre météo" onAction="#suggererOffreMeteo"
                                style="-fx-background-color: #00bcd4; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="220"/>
                        <Button text="🌍 Voir la météo" onAction="#afficherMeteo"
                                style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-weight: bold;" prefWidth="180"/>
                    </HBox>
                </VBox>

                <!-- RECHERCHE -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                            <Label text="🔍" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                        </StackPane>
                        <Label text="Rechercher une offre"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                    </HBox>
                    <Separator style="-fx-background-color: #16325c;" />
                    <HBox spacing="10">
                        <TextField fx:id="searchField" promptText="Titre, service, prix..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #16325c; -fx-border-radius: 10; -fx-background-color: #F5F5DC;"/>
                        <Button text="🔍" onAction="#rechercherOffres"
                                style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                        <Button text="🔄" onAction="#reinitialiserRecherche"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Prix entre:" style="-fx-text-fill: #16325c;"/>
                        <TextField fx:id="prixMinField" promptText="Min" prefWidth="80"
                                   style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;"/>
                        <Label text="-" />
                        <TextField fx:id="prixMaxField" promptText="Max" prefWidth="80"
                                   style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="resultatsCountLabel" text="0 offre(s)"
                               style="-fx-text-fill: #16325c; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #F5F5DC; -fx-padding: 8 15; -fx-background-radius: 20;"/>
                    </HBox>
                </VBox>

                <!-- LISTE -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-border-color: #16325c; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane style="-fx-background-color: #16325c; -fx-padding: 8; -fx-background-radius: 8;">
                            <Label text="📋" style="-fx-font-size: 20px; -fx-text-fill: white;" />
                        </StackPane>
                        <Label text="Nos Offres"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                        <Label fx:id="totalOffresLabel" text="(0 offres)"
                               style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                    </HBox>
                    <Separator style="-fx-background-color: #16325c;" />
                    <ScrollPane fx:id="scrollPane" prefHeight="400" fitToWidth="true"
                                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border: none;">
                        <VBox fx:id="offresVBox" spacing="15" style="-fx-padding: 10;"/>
                    </ScrollPane>
                    <HBox alignment="CENTER">
                        <Label text="✨ Cliquez sur 'Sélectionner' pour modifier une offre ✨"
                               style="-fx-text-fill: #16325c; -fx-font-size: 13px; -fx-font-style: italic; -fx-background-color: #F5F5DC; -fx-padding: 8 20; -fx-background-radius: 30;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
