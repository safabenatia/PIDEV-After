<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.AdminReservationController"
            style="-fx-background-color: #FEFAF6;">

    <VBox spacing="0">

        <!-- ── TOP NAVBAR ── -->
        <HBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: #005082;
                     -fx-padding: 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">

            <!-- Brand -->
            <HBox alignment="CENTER" spacing="12"
                  style="-fx-background-color: #0081C9; -fx-padding: 18 28 18 28;">
                <Label text="✈️" style="-fx-font-size: 24px;"/>
                <Label text="AFTER Admin" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="👤 Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 30 0 0;"/>
        </HBox>

        <!-- ── MAIN LAYOUT ── -->
        <HBox VBox.vgrow="ALWAYS">

            <!-- SIDEBAR -->
            <VBox spacing="8" prefWidth="220"
                  style="-fx-background-color: #005082; -fx-padding: 25 15 25 15;">

                <Button text="🗓 Réservations" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; 
                               -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12 18; 
                               -fx-alignment: CENTER_LEFT; -fx-background-radius: 10;"/>

                <Button text="💳 Paiements" onAction="#ouvrirAdminPaiement" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: white; 
                               -fx-font-size: 14px; -fx-padding: 12 18; -fx-alignment: CENTER_LEFT; 
                               -fx-cursor: hand;"/>

                <Button text="📊 Statistiques" onAction="#ouvrirAdminStats" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: white; 
                               -fx-font-size: 14px; -fx-padding: 12 18; -fx-alignment: CENTER_LEFT; 
                               -fx-cursor: hand;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="👤 Vue Utilisateur" onAction="#ouvrirVueUtilisateur" maxWidth="Infinity"
                        style="-fx-background-color: #A79277; -fx-text-fill: white; 
                               -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>
            </VBox>

            <!-- CONTENT -->
            <VBox spacing="25" HBox.hgrow="ALWAYS" style="-fx-padding: 35 45 35 45;">

                <!-- Header row -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5">
                        <Label text="Gestion des Réservations"
                               style="-fx-text-fill: #005082; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCount" style="-fx-text-fill: #A79277; -fx-font-size: 13px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="tfSearch" promptText="🔍 Rechercher par lieu, type, date..." prefWidth="350"
                               style="-fx-background-color: white; -fx-border-color: #A7927744; 
                                      -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10 15;"/>
                </HBox>

                <!-- Table Container -->
                <VBox VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 15; 
                             -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 10);">
                    <TableView fx:id="tableReservations" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-base: white; -fx-selection-bar: #0081C922;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                            <TableColumn fx:id="colLieu" text="Lieu" prefWidth="100"/>
                            <TableColumn fx:id="colVoyage" text="Voyage" prefWidth="70"/>
                            <TableColumn fx:id="colUser" text="Client" prefWidth="70"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                            <TableColumn fx:id="colNb" text="Pers." prefWidth="50"/>
                            <TableColumn fx:id="colPrix" text="Prix" prefWidth="90"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <StackPane fx:id="notifOverlay" alignment="BOTTOM_CENTER" mouseTransparent="true" 
               style="-fx-padding: 0 0 30 0;"/>
</StackPane>
