<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.ActiviteListController"
            stylesheets="@style.css"
            style="-fx-background-image: url('/images/I.png');
                   -fx-background-size: cover;
                   -fx-background-position: center center;
                   -fx-background-repeat: no-repeat;">


    <top>
        <VBox spacing="0" style="-fx-background-color: rgba(0,0,0,0.4);">

            <!-- Main Header -->
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="80" right="30" bottom="20" left="30"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                    <StackPane style="-fx-min-width: 55; -fx-min-height: 55;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-background-radius: 50;">
                        <Label text="✈️" style="-fx-font-size: 28px;"/>
                    </StackPane>

                    <VBox spacing="0">
                        <Label text="Gestion des Activités Touristiques"
                               style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Ajoutez, modifiez et organisez vos activités facilement"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>



                <Button text="Voir Jours Fériés"
                        onAction="#openHolidayPage"
                        prefWidth="200"/>

                <Button text="🗓️ Planning"
                        onAction="#handlePlanning"
                        prefHeight="40" prefWidth="170"
                        style="-fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-color: #291eff;
                               -fx-background-radius: 20;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: rgba(0,0,0,0.35);">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>

                <VBox spacing="3">
                    <Label text="🗺️ Liste des Activités"
                           style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Recherchez et triez vos activités"
                           style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>


                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-background-color: rgba(255,255,255,0.9);
                             -fx-background-radius: 20;
                             -fx-padding: 8 16;">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="txtSearch"
                               promptText="Rechercher par nom, catégorie ou lieu..."
                               prefWidth="240"
                               style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                </HBox>


                <ComboBox fx:id="comboSort"
                          promptText="Trier par prix"
                          prefWidth="180"
                          style="-fx-font-size: 13px;"/>


                <Button text="+ Nouvelle Activité"
                        onAction="#handleAdd"
                        prefHeight="40" prefWidth="180"
                        style="-fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-color: #2D6A4F;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="20" style="-fx-background-color: #1e3a5f; ">
            <padding>
                <Insets top="32" right="16" bottom="32" left="16"/>
            </padding>
            <Label text="After Travel" styleClass="sidebar-title"/>
            <VBox spacing="12">
                <Label text="Mon Profil"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleRetourProfil"
                       style="-fx-cursor: hand;"/>
                <Label text="🗺️ Voyages &amp; Destinations"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleVoyages"
                       style="-fx-cursor: hand;"
                       fx:id="activitebtn"/>
                <Label text="🏨 Services &amp; Offres"
                       styleClass="sidebar-btn"
                       onMouseClicked="#showactivite"
                       style="-fx-cursor: hand;"
                       fx:id="servicesBtn"/>
                <Label text="🏄 Activite &amp; Planning" style="-fx-text-fill:#FFD700; -fx-font-size:14px; -fx-cursor:hand; -fx-font-weight:bold;"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" styleClass="sidebar-logout" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <FlowPane fx:id="activiteContainer"
                      hgap="20"
                      vgap="20"
                      style="-fx-padding: 25;"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40"
              style="-fx-background-color: rgba(255,255,255,0.9);
                     -fx-padding: 15 30;
                     -fx-border-color: #E9ECEF;
                     -fx-border-width: 1 0 0 0;">


            <VBox alignment="CENTER">
                <Label text="💰 Budget Total"
                       style="-fx-font-size: 12px; -fx-text-fill: #6C757D;"/>
                <Label fx:id="lblTotalBudget"
                       text="-- DT"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2D6A4F;"/>
            </VBox>


            <VBox alignment="CENTER">
                <Label text="📌 Nombre d'Activités"
                       style="-fx-font-size: 12px; -fx-text-fill: #6C757D;"/>
                <Label fx:id="lblTotalActivites"
                       text="--"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2D6A4F;"/>
            </VBox>


            <VBox alignment="CENTER">
                <Label text="📅 Dernière Mise à Jour"
                       style="-fx-font-size: 12px; -fx-text-fill: #6C757D;"/>
                <Label fx:id="lblLastUpdate"
                       text="Aujourd'hui"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2D6A4F;"/>
            </VBox>

        </HBox>
    </bottom>

</BorderPane>
