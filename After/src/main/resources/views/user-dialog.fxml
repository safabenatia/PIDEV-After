<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.UserDialogController"
      spacing="14"
      alignment="CENTER"
      style="-fx-background-color: #f9fafb; -fx-padding: 20;">

    <!-- Titre -->
    <Label fx:id="titleLabel"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>

    <Separator style="-fx-max-width: 340; -fx-padding: 0 0 6 0; -fx-opacity: 0.4;"/>

    <!-- Carte principale -->
    <VBox spacing="10"
          prefWidth="360"
          maxWidth="360"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">

        <GridPane hgap="12" vgap="10">

            <Label text="Nom"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nomField"
                       promptText="Nom"
                       style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 7;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Prénom"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="prenomField"
                       promptText="Prénom"
                       style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 7;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Email"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField"
                       promptText="email@exemple.com"
                       style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 7;"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Mot de passe"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1">
                <PasswordField fx:id="passwordField"
                               promptText="Nouveau (optionnel)"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 7;"/>
                <ToggleButton fx:id="toggleEye"
                              text="👁"
                              style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 15px; -fx-min-width: 36px;"/>
            </HBox>

            <Label text="Téléphone"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="telephoneField"
                       promptText="+216 ..."
                       style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 7;"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Changement ici : Rôle → Type d'utilisateur -->
            <Label text="Type d'utilisateur"
                   style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"
                   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="typeCombo"
                      promptText="Choisir le type"
                      style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        </GridPane>

        <!-- Photo -->
        <Label text="Photo (optionnelle)"
               style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Choisir"
                    onAction="#handleChooseImage"
                    styleClass="btn-primary"
                    style="-fx-padding: 6 14; -fx-font-size: 12.5px;"/>
            <Label fx:id="photoFileName"
                   text="Aucune"
                   style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;"/>
        </HBox>

        <ImageView fx:id="photoPreview"
                   fitHeight="90"
                   fitWidth="90"
                   preserveRatio="true"
                   style="-fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 9999; -fx-background-color: #f1f5f9;"/>

    </VBox>

    <!-- Boutons d'action -->
    <HBox spacing="10"
          alignment="CENTER_RIGHT"
          style="-fx-padding: 10 0 0 0;">
        <Button text="Annuler"
                onAction="#handleCancel"
                styleClass="btn-secondary"
                style="-fx-padding: 6 16; -fx-font-size: 12.5px;"/>
        <Button text="Enregistrer"
                onAction="#handleSave"
                styleClass="btn-primary"
                defaultButton="true"
                style="-fx-padding: 6 16; -fx-font-size: 12.5px;"/>
    </HBox>

</VBox>