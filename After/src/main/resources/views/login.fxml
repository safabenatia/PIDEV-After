<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.LoginController"
      spacing="30" alignment="CENTER"
      style="-fx-background-color: #f8fafc; -fx-padding: 50;">




    <Label text="Commencez votre nouveau voyage avec After Travel "
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e40af; -fx-text-alignment: center;"/>

    <!-- Carte centrée -->
    <VBox spacing="20" prefWidth="380" maxWidth="380"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 16; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 8);">

        <Label text="Email" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-padding: 6;">
            <Label text="✉" style="-fx-font-size: 20px; -fx-text-fill: #64748b; -fx-min-width: 40; -fx-alignment: center;"/>
            <TextField fx:id="emailField" promptText="votre@email.com" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-prompt-text-fill: #94a3b8;"/>
        </HBox>

        <Label text="Mot de passe" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-padding: 6;">
            <Label text="🔒" style="-fx-font-size: 20px; -fx-text-fill: #64748b; -fx-min-width: 40; -fx-alignment: center;"/>
            <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #94a3b8;"/>
            <ToggleButton fx:id="toggleEye" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px;"/>
        </HBox>

        <Hyperlink text="Mot de passe oublié ?" style="-fx-text-fill: #3b82f6; -fx-font-size: 14px; -fx-alignment: center-right;"/>

        <Button text="Se connecter" prefWidth="9999" prefHeight="48"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 12;"
                onAction="#handleLogin"/>

    </VBox>

    <HBox alignment="CENTER" spacing="8">
        <Label text="Pas encore de compte ?" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
        <Hyperlink text="S'inscrire" onAction="#goToSignUp" style="-fx-text-fill: #3b82f6;"/>
    </HBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 14px;"/>

</VBox>