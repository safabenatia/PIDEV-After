<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SignUpController"
      spacing="12"
      alignment="CENTER"
      style="-fx-background-color: #f8fafc; -fx-padding: 24;">

    <!-- Titre / slogan -->
    <Label text="Commence ton voyage vers le bien-être avec After Travel"
           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e40af; -fx-text-alignment: center; -fx-wrap-text: true; -fx-padding: 0 0 16 0;"/>

    <!-- Carte d'inscription -->
    <VBox spacing="10"
          prefWidth="340"
          maxWidth="340"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">

        <Label text="Prénom *" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="prenomField"
                   promptText="Sophie"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 13px;"/>

        <Label text="Nom *" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="nomField"
                   promptText="Martin"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 13px;"/>

        <Label text="Email *" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="emailField"
                   promptText="votre@email.com"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 13px;"/>

        <Label text="Mot de passe *" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <PasswordField fx:id="passwordField"
                           HBox.hgrow="ALWAYS"
                           promptText="Au moins 8 caractères..."
                           style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 13px;"/>
            <ToggleButton fx:id="toggleEye"
                          text="👁"
                          style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16px; -fx-min-width: 36px;"/>
        </HBox>

        <Label text="Téléphone (optionnel)" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="telephoneField"
                   promptText="+216 ..."
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 13px;"/>

        <!-- Info rôle forcé -->
        <Label text="Type de compte : Voyageur (automatique)"
               style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-padding: 4 0 0 0;"/>

        <!-- Photo -->
        <Label text="Photo de profil (optionnelle)" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563; -fx-padding: 8 0 0 0;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Choisir une photo"
                    onAction="#handleChooseImage"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 14; -fx-font-size: 12.5px;"/>
            <Label fx:id="photoFileName"
                   text="Aucune sélectionnée"
                   style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;"/>
        </HBox>

        <ImageView fx:id="photoPreview"
                   fitHeight="80"
                   fitWidth="80"
                   preserveRatio="true"
                   style="-fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-color: #f8fafc;"/>

        <!-- Bouton principal -->
        <Button text="Créer mon compte"
                prefWidth="9999"
                prefHeight="42"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10;"
                onAction="#handleSignUp"/>

    </VBox>

    <!-- Lien vers connexion -->
    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 16 0 0 0;">
        <Label text="Déjà un compte ?"
               style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;"/>
        <Hyperlink text="Se connecter"
                   onAction="#goToLogin"
                   style="-fx-text-fill: #3b82f6; -fx-font-size: 12.5px;"/>
    </HBox>

    <!-- Zone d'erreur -->
    <Label fx:id="errorLabel"
           style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 8 0 0 0; -fx-text-alignment: center;"/>

</VBox>