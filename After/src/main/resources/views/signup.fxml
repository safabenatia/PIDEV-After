<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SignUpController"
      spacing="10" alignment="CENTER"
      style="-fx-background-color: #f8fafc; -fx-padding: 20;">

    <!-- Logo + slogan très réduit -->


    <Label text="Commence ton voyage vers le bien-être avec After Travel"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e40af; -fx-text-alignment: center; -fx-wrap-text: true;"/>

    <!-- Carte ultra-compacte -->
    <VBox spacing="8" prefWidth="320" maxWidth="320"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">

        <Label text="Prénom" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="prenomField" promptText="Sophie"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 7; -fx-padding: 6; -fx-font-size: 13px;"/>

        <Label text="Nom" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="nomField" promptText="Martin"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 7; -fx-padding: 6; -fx-font-size: 13px;"/>

        <Label text="Email" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-background-radius: 7; -fx-padding: 2 6;">
            <Label text="✉" style="-fx-font-size: 15px; -fx-text-fill: #64748b; -fx-min-width: 28; -fx-alignment: center;"/>
            <TextField fx:id="emailField" promptText="votre@email.com" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-prompt-text-fill: #94a3b8; -fx-font-size: 13px;"/>
        </HBox>

        <Label text="Mot de passe" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-background-radius: 7; -fx-padding: 2 6;">
            <Label text="🔒" style="-fx-font-size: 15px; -fx-text-fill: #64748b; -fx-min-width: 28; -fx-alignment: center;"/>
            <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            <ToggleButton fx:id="toggleEye" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px;"/>
        </HBox>

        <Label text="Téléphone (optionnel)" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <TextField fx:id="telephoneField" promptText="+216 ..."
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 7; -fx-padding: 6; -fx-font-size: 13px;"/>

        <Label text="Rôle : Voyageur (automatique)" style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>

        <Label text="Photo (optionnel)" style="-fx-font-size: 12.5px; -fx-text-fill: #4b5563;"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="Choisir" onAction="#handleChooseImage"
                    style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-background-radius: 7; -fx-padding: 5 12; -fx-font-size: 12px;"/>
            <Label fx:id="photoFileName" text="Aucune sélectionnée" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
        </HBox>

        <ImageView fx:id="photoPreview" fitHeight="70" fitWidth="70" preserveRatio="true"
                   style="-fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-border-radius: 7;"/>

        <Button text="S'inscrire" prefWidth="9999" prefHeight="36"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 9;"
                onAction="#handleSignUp"/>

    </VBox>

    <HBox alignment="CENTER" spacing="6">
        <Label text="Déjà un compte ?" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <Hyperlink text="Se connecter" onAction="#goToLogin" style="-fx-text-fill: #3b82f6; -fx-font-size: 12px;"/>
    </HBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>

</VBox>