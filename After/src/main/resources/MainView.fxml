<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainViewController"
            stylesheets="@/dashboardAdmin.css"
            style="-fx-background-color: #F5F5DC;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color:#16325c; -fx-padding:15;">
            <ImageView fx:id="logoImage" fitHeight="74.0" fitWidth="91.0">
                <image>
                    <Image url="@images/Blue and Yellow Illustrative Travel Agency Logo - 1.png"/>
                </image>
            </ImageView>
            <Label style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;" text="by novajourney"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Rechercher..."/>
            <Button onAction="#showFavorites" text="♥ Favoris"/>
            <Button onAction="#showRecommendations" text="Recommandations"/>
            <Button text="📊 Statistiques" onAction="#showStatistics"/>
            <Button onAction="#showVoyages" text="Voyages"/>
            <Button onAction="#showDestinations" text="Destinations"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="20" style="-fx-background-color: #1e3a5f;">
            <padding>
                <Insets top="32" right="16" bottom="32" left="16"/>
            </padding>
            <Label text="After Travel" styleClass="sidebar-title"/>
            <VBox spacing="12">
                <Label text="Mon Profil"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleRetourProfil"
                       style="-fx-cursor: hand;"/>
                <Label text="🗺️ Voyages &amp; Destinations"
                       style="-fx-text-fill:#FFD700; -fx-font-size:14px; -fx-cursor:hand; -fx-font-weight:bold;"/>
                <Label text="🏨 Services &amp; Offres"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleServicesOffres"
                       style="-fx-cursor: hand;"
                       fx:id="servicesBtn"/>
                <Label text="🏄 Activite &amp; Planning"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleActivitePlanning"
                       style="-fx-cursor: hand;"
                       fx:id="activitebtn"/>
                <Label text="📝 Documents"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleDocument"
                       style="-fx-cursor: hand;"
                       fx:id="documentbtn"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" styleClass="sidebar-logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <BorderPane style="-fx-background-color:#F5F5DC;">
            <top>
                <HBox fx:id="crudBox" alignment="CENTER_RIGHT" spacing="15" style="-fx-padding:15;"/>
            </top>
            <center>
                <ScrollPane fitToWidth="true"
                            style="-fx-background:#F5F5DC; -fx-background-color:#F5F5DC;">
                    <content>
                        <StackPane fx:id="mainContent" style="-fx-padding:20; -fx-background-color:#F5F5DC;"/>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>
