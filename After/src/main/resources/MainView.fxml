<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color:#16325c; -fx-padding:15;">

            <ImageView fx:id="logoImage" fitHeight="74.0" fitWidth="91.0">
            <image>
               <Image url="@images/Blue and Yellow Illustrative Travel Agency Logo - 1.png" />
            </image></ImageView>

            <Label style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;" text="by novajourney" />

            <Pane HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField" promptText="Rechercher..." />
            <Button onAction="#showFavorites" text="♥ Favoris" />
            <Button onAction="#showRecommendations" text="Recommandations" />
            <Button text="📊 Statistiques" onAction="#showStatistics"/>
            <Button onAction="#showVoyages" text="Voyages" />
            <Button onAction="#showDestinations" text="Destinations" />


        </HBox>
    </top>

    <center>
        <BorderPane style="-fx-background-color:#F5F5DC;">

            <top>
                <HBox fx:id="crudBox" alignment="CENTER_RIGHT" spacing="15" style="-fx-padding:15;">
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            style="-fx-background:#F5F5DC; -fx-background-color:#F5F5DC;">
                    <content>
                        <StackPane fx:id="mainContent" style="-fx-padding:20; -fx-background-color:#F5F5DC;" />
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>
    </center>


</BorderPane>
