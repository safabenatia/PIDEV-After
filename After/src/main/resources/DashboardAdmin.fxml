<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardAdminController"
            stylesheets="@dashboardAdmin.css"
            style="-fx-background-color: #F5F5DC;">

    <!-- Sidebar gauche -->
    <left>
        <VBox styleClass="sidebar" spacing="20">
            <padding>
                <Insets top="32" right="16" bottom="32" left="16"/>
            </padding>
            <Label text="After Travel" styleClass="sidebar-title"/>
            <VBox spacing="12">
                <Label text="👥 Utilisateurs"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleShowUsers"
                       style="-fx-cursor: hand;"/>
                <Label text="🗺️ Voyages &amp; Destinations"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleVoyages"
                       style="-fx-cursor: hand;"/>
                <Label text="🎟️ Réservations"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleReservations"
                       style="-fx-cursor: hand;"/>
                <Label text="📊 Statistiques Services"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleStats"
                       style="-fx-cursor: hand;"/>
                <Label text="🗺️ Actvite &amp; Planning "
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleActivitesPlanning"
                       style="-fx-cursor: hand;"/>

                <Label text="📁 Dashboard Documents"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleDashboardDocuments"
                       style="-fx-cursor: hand;"/>

                <Label text="🎟️ Dépenses"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleDepense"
                       style="-fx-cursor: hand;"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" styleClass="sidebar-logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <StackPane fx:id="contentArea">

            <!-- Panel Utilisateurs -->
            <VBox fx:id="usersPanel" spacing="28" style="-fx-padding: 32;">

                <!-- Header avec recherche + filtres + boutons -->
                <VBox spacing="20" styleClass="main-header">
                    <Label text="Gestion des utilisateurs" styleClass="page-title"/>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Rechercher un utilisateur..."
                                   styleClass="search-box"
                                   prefWidth="360"/>

                        <ComboBox fx:id="typeFilterCombo"
                                  promptText="Tous les types"
                                  prefWidth="200"/>

                        <Button text="Réinitialiser"
                                styleClass="btn-secondary"
                                onAction="#resetFilters"/>

                        <Button text="Ajouter utilisateur"
                                styleClass="btn-primary"
                                onAction="#handleAddUser"/>

                        <Button text="📄 CSV"
                                styleClass="btn-success"
                                onAction="#handleExportCSV"
                                style="-fx-padding: 8 16; -fx-font-size: 13px;"/>

                        <Button text="📄 PDF"
                                styleClass="btn-info"
                                onAction="#handleExportPDF"
                                style="-fx-padding: 8 16; -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>

                <!-- Statistiques -->
                <HBox spacing="24" alignment="CENTER">

                    <!-- Carte Total utilisateurs -->
                    <VBox styleClass="stats-card" alignment="CENTER" prefWidth="280">
                        <Label text="Total utilisateurs" styleClass="stats-label"/>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="stats-value"/>
                    </VBox>

                    <!-- Carte Voyageurs -->
                    <VBox styleClass="stats-card" alignment="CENTER" prefWidth="280">
                        <Label text="Voyageurs" styleClass="stats-label"/>
                        <Label fx:id="voyageursLabel" text="0" styleClass="stats-value"/>
                    </VBox>

                    <!-- Carte Administrateurs -->
                    <VBox styleClass="stats-card" alignment="CENTER" prefWidth="280">
                        <Label text="Administrateurs" styleClass="stats-label"/>
                        <Label fx:id="adminsLabel" text="0" styleClass="stats-value"/>
                    </VBox>

                </HBox>
                <!-- Zone des cartes utilisateurs -->
                <ScrollPane fitToWidth="true"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <FlowPane fx:id="usersFlowPane"
                              hgap="24"
                              vgap="24"
                              alignment="CENTER"/>
                </ScrollPane>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
