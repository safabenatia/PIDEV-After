<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.PlanningListController"
            stylesheets="@style.css"
            style="-fx-background-image: url('/images/I.png');
                   -fx-background-size: cover;
                   -fx-background-position: center center;
                   -fx-background-repeat: no-repeat;">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="0" style="-fx-background-color: rgba(0,0,0,0.4);">

            <!-- Title -->
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="80" right="30" bottom="20" left="30"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                    <StackPane style="-fx-min-width: 55; -fx-min-height: 55;
                                      -fx-background-color: rgba(255,255,255,0.2);
                                      -fx-background-radius: 50;">
                        <Label text="📅" style="-fx-font-size: 28px;"/>
                    </StackPane>

                    <VBox spacing="0">
                        <Label text="Gestion des Plannings"
                               style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Organisez vos activités par date et heure"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <Button text="+ Nouveau Planning"
                        onAction="#handleAddPlanning"
                        prefHeight="40" prefWidth="180"
                        style="-fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-color: #2D6A4F;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;"/>
                <Button fx:id="backButton"
                        text="⬅ Retour aux Activités"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 20;"
                        onAction="#handleBack"/>
            </HBox>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: rgba(0,0,0,0.35);">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>

                <Label text="🗂️ Liste des Plannings"
                       style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>



                <!-- 🔽 Tri -->
                <ComboBox fx:id="comboSortPlanning"
                          promptText="Trier par"
                          prefWidth="180"/>
            </HBox>
        </VBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <FlowPane fx:id="planningContainer"
                      hgap="20"
                      vgap="20"
                      style="-fx-padding: 25;"/>
        </ScrollPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="40"
              style="-fx-background-color: rgba(255,255,255,0.9);
                     -fx-padding: 15 30;">

            <VBox alignment="CENTER">
                <Label text="📌 Total Plannings"
                       style="-fx-font-size: 12px; -fx-text-fill: #6C757D;"/>
                <Label fx:id="lblTotalPlanning"
                       text="--"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2D6A4F;"/>
            </VBox>

        </HBox>
    </bottom>

</BorderPane>
