<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #F5F5DC; -fx-background: #F5F5DC;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.CategorieControllerV2">

    <content>
        <AnchorPane prefWidth="1200" style="-fx-background-color: #F5F5DC;">
            <children>
                <!-- En-tête -->
                <VBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                      style="-fx-background-color: #16325c; -fx-padding: 20;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <children>
                                <Label style="-fx-font-size: 32px; -fx-text-fill: #F5F5DC;" text="✈" />
                                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="AFTER Travel - ADMIN" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-size: 20px; -fx-text-fill: #F5F5DC;" text="Gestion des Catégories" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="20" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0"
                      AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="90.0">
                    <children>

                        <!-- ========== PANNEAU DE STATISTIQUES ========== -->
                        <HBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label text="📊 Statistiques" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c; -fx-padding: 0 10 0 0;"/>

                                <!-- Stat 1 : Total Catégories -->
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="180">
                                    <children>
                                        <Label text="📁" style="-fx-font-size: 24px;"/>
                                        <Label text="Total Catégories" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                                        <Label fx:id="statTotalCategories" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16325c;"/>
                                    </children>
                                </VBox>

                                <!-- Stat 2 : Catégorie la plus utilisée -->
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #FFF3E0; -fx-padding: 15; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="🔥" style="-fx-font-size: 24px;"/>
                                        <Label text="Plus Utilisée" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                                        <Label fx:id="statPlusUtilisee" text="---" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #F57C00; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                                        <Label fx:id="statPlusUtiliseeNb" text="(0 dépenses)" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                                    </children>
                                </VBox>

                                <!-- Stat 3 : Catégorie avec plus de dépenses -->
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E8F5E9; -fx-padding: 15; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="💰" style="-fx-font-size: 24px;"/>
                                        <Label text="Plus Dépensée" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                                        <Label fx:id="statPlusDepensee" text="---" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4CAF50; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                                        <Label fx:id="statPlusDepenseeMontant" text="(0.00 DT)" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                                    </children>
                                </VBox>

                                <!-- Bouton Actualiser -->
                                <VBox alignment="CENTER" spacing="5">
                                    <children>
                                        <Button fx:id="btnActualiserStats" text="🔄"
                                                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 10 15; -fx-background-radius: 50%; -fx-cursor: hand;">
                                            <tooltip><Tooltip text="Actualiser les statistiques"/></tooltip>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- ========== GRAPHIQUES ========== -->
                        <HBox spacing="20" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="🥧 Répartition des dépenses par catégorie"/>
                                        <PieChart fx:id="pieChartCategories" prefHeight="300" prefWidth="400"
                                                  style="-fx-background-color: transparent;"
                                                  legendVisible="true" labelsVisible="true"
                                                  animated="true" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </VBox>

                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="📊 Top 5 des catégories par montant"/>
                                        <BarChart fx:id="barChartDepenses" prefHeight="300" prefWidth="400"
                                                  style="-fx-background-color: transparent;"
                                                  animated="true" HBox.hgrow="ALWAYS">
                                            <xAxis>
                                                <CategoryAxis fx:id="xAxis" side="BOTTOM" label="Catégories"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis fx:id="yAxis" side="LEFT" label="Montant (DT)"/>
                                            </yAxis>
                                        </BarChart>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Formulaire d'ajout -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="📝 Informations de la Catégorie" />

                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Nom de la catégorie *" />
                                        <TextField fx:id="nomField" promptText="Ex: Transport, Restaurant..."
                                                   style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" />
                                    </children>
                                </VBox>

                                <HBox alignment="BOTTOM_LEFT" spacing="10">
                                    <children>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Icône (Image)" />
                                                <TextField fx:id="iconeField" promptText="Chemin de l'image..."
                                                           style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" />
                                            </children>
                                        </VBox>
                                        <VBox alignment="BOTTOM_CENTER">
                                            <children>
                                                <Label text=" "/>
                                                <Button fx:id="parcourirBtn" text="📁 Parcourir"
                                                        style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 12 25; -fx-background-radius: 8; -fx-cursor: hand;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #16325c; -fx-font-weight: bold;" text="Description *" />
                                        <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Description de la catégorie..."
                                                  style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #16325c; -fx-border-radius: 8;" wrapText="true" />
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <children>
                                        <Button fx:id="ajouterBtn" text="➕ Ajouter la catégorie"
                                                style="-fx-background-color: #FFD700; -fx-text-fill: #16325c; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" />
                                        <Button fx:id="annulerBtn" text="🔄 Réinitialiser"
                                                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Liste des catégories -->
                        <VBox VBox.vgrow="ALWAYS" spacing="15">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <children>
                                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16325c;" text="📂 Liste des Catégories" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="countLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16325c; -fx-background-color: white; -fx-padding: 8 15; -fx-background-radius: 8;" text="Total: 0 catégories" />
                                    </children>
                                </HBox>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" prefHeight="300"
                                            style="-fx-background-color: transparent; -fx-background: transparent;">
                                    <content>
                                        <VBox fx:id="categoriesContainer" spacing="10" style="-fx-padding: 5;">
                                            <!-- Les cartes catégories seront ajoutées dynamiquement -->
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- Espace en bas pour le défilement -->
                        <Region prefHeight="20"/>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </content>
</ScrollPane>