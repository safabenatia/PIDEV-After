<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="750" prefWidth="1200" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController">

    <!-- ==================== TOP NAVBAR ==================== -->
    <top>
        <HBox style="-fx-background-color: #16325c; -fx-padding: 8 25; -fx-alignment: CENTER_LEFT;" prefHeight="50">
            <Label text="AFTER Travel - Dashboard"
                   style="-fx-text-fill: #F5F5DC; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10">
                <Button fx:id="minimizeButton" text="─"
                        style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 18px; -fx-cursor: hand;" />
                <Button fx:id="maximizeButton" text="□"
                        style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 18px; -fx-cursor: hand;" />
                <Button fx:id="closeButton" text="✕"
                        style="-fx-background-color: transparent; -fx-text-fill: #F5F5DC; -fx-font-size: 18px; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </top>

    <!-- ==================== LEFT SIDEBAR ==================== -->
    <left>
        <VBox spacing="20"
              style="-fx-background-color: #1e3a5f; -fx-padding: 32 16 32 16; -fx-min-width: 200;">

            <!-- Sidebar Title -->
            <Label text="After Travel"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

            <!-- Nav Links -->
            <VBox spacing="12">
                <Label text="🏠 Accueil"
                       style="-fx-text-fill: #F5F5DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: bold;" />
                <Separator style="-fx-background-color: rgba(255,255,255,0.2);" />
                <Label text="👤 Mon Profil"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleRetourProfil" />
                <Label text="🏨 Services"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleServices" />
                <Label text="🏷️ Offres"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleOffres" />
                <Label text="📊 Statistiques"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                       onMouseClicked="#handleStats" />
            </VBox>

            <!-- Push logout to bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button -->
            <Button text="🚪 Déconnexion"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 8;"
                    onAction="#handleLogout" />
        </VBox>
    </left>

    <!-- ==================== MAIN CONTENT ==================== -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20"
              style="-fx-background-color: #F5F5DC; -fx-padding: 20 40 20 40;">

            <!-- ========== LOGO AFTER TRAVEL ========== -->
            <StackPane style="-fx-padding: 10 0 0 0;">
                <VBox alignment="CENTER" spacing="5">
                    <HBox alignment="CENTER" spacing="20">
                        <Circle radius="30" fill="#16325c" />
                        <Label text="✈️" style="-fx-font-size: 60px; -fx-rotate: -10;" />
                        <Label text="AFTER" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #16325c; -fx-font-family: 'Montserrat';" />
                        <Label text="Travel" style="-fx-font-size: 48px; -fx-font-weight: 300; -fx-text-fill: #16325c; -fx-font-family: 'Montserrat';" />
                        <Label text="🌍" style="-fx-font-size: 60px; -fx-rotate: 10;" />
                        <Circle radius="30" fill="#FFD700" opacity="0.3" />
                    </HBox>
                    <Label text="Votre agence de voyages intelligente"
                           style="-fx-text-fill: #16325c; -fx-font-size: 16px; -fx-font-style: italic;" />
                </VBox>
            </StackPane>

            <!-- BANDEAU STATISTIQUES -->
            <HBox spacing="30" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);"
                  prefHeight="140">
                <VBox alignment="CENTER" spacing="5" prefWidth="200">
                    <Circle radius="30" fill="#16325c" />
                    <Label text="🏨" style="-fx-font-size: 30px; -fx-text-fill: white; -fx-translate-y: -45;" />
                    <Label text="Services" style="-fx-text-fill: #16325c; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    <Label fx:id="totalServices" text="11" style="-fx-text-fill: #16325c; -fx-font-size: 36px; -fx-font-weight: bold;" />
                    <Label text="prestations disponibles" style="-fx-text-fill: #666; -fx-font-size: 11px;" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="✨" style="-fx-font-size: 30px;" />
                    <Label text="Bienvenue" style="-fx-text-fill: #16325c; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <Label text="sur votre espace de gestion" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="✈️" style="-fx-font-size: 16px;" />
                        <Label text="Explorez, créez, réservez" style="-fx-text-fill: #16325c; -fx-font-size: 14px; -fx-font-style: italic;" />
                        <Label text="🌍" style="-fx-font-size: 16px;" />
                    </HBox>
                </VBox>
                <VBox alignment="CENTER" spacing="5" prefWidth="200">
                    <Circle radius="30" fill="#16325c" />
                    <Label text="🏷️" style="-fx-font-size: 30px; -fx-text-fill: white; -fx-translate-y: -45;" />
                    <Label text="Offres" style="-fx-text-fill: #16325c; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    <Label fx:id="totalOffres" text="6" style="-fx-text-fill: #16325c; -fx-font-size: 36px; -fx-font-weight: bold;" />
                    <Label text="promotions actives" style="-fx-text-fill: #666; -fx-font-size: 11px;" />
                </VBox>
            </HBox>

            <!-- SECTION TITRE AVEC DATE -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 5 0;">
                <Separator style="-fx-background-color: #16325c; -fx-opacity: 0.3;" prefWidth="100" />
                <Label text="⚡ GESTION DE CONTENU ⚡"
                       style="-fx-text-fill: #16325c; -fx-font-size: 20px; -fx-font-weight: bold;" />
                <Separator style="-fx-background-color: #16325c; -fx-opacity: 0.3;" prefWidth="100" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #666; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </HBox>

            <!-- CARTES DE NAVIGATION -->
            <GridPane hgap="30" vgap="20" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="34" />
                </columnConstraints>

                <!-- CARTE SERVICES -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);"
                      onMouseClicked="#handleServices" prefWidth="280" prefHeight="260" GridPane.columnIndex="0">
                    <StackPane prefHeight="100" style="-fx-background-color: #16325c; -fx-background-radius: 20 20 0 0;">
                        <Label text="🏨" style="-fx-font-size: 50px;" />
                    </StackPane>
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <Label text="Gestion des Services"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                        <Label text="Hébergement · Transport · Activités · Guides"
                               style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;" />
                        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                            <Label fx:id="totalServicesCard" text="11 services"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Accéder →"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- CARTE OFFRES -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);"
                      onMouseClicked="#handleOffres" prefWidth="280" prefHeight="260" GridPane.columnIndex="1">
                    <StackPane prefHeight="100" style="-fx-background-color: #16325c; -fx-background-radius: 20 20 0 0;">
                        <Label text="🏷️" style="-fx-font-size: 50px;" />
                    </StackPane>
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <Label text="Gestion des Offres"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                        <Label text="Promotions · Packs exclusifs · Offres saisonnières"
                               style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;" />
                        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                            <Label fx:id="totalOffresCard" text="6 promotions"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Accéder →"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- CARTE STATISTIQUES -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);"
                      onMouseClicked="#handleStats" prefWidth="280" prefHeight="260" GridPane.columnIndex="2">
                    <StackPane prefHeight="100" style="-fx-background-color: #16325c; -fx-background-radius: 20 20 0 0;">
                        <Label text="📊" style="-fx-font-size: 50px;" />
                    </StackPane>
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <Label text="Statistiques"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16325c;" />
                        <Label text="Analyses · Graphiques · KPIs · Performances"
                               style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;" />
                        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 0 0;">
                            <Label text="Voir les analyses"
                                   style="-fx-text-fill: #16325c; -fx-font-size: 12px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Accéder →"
                                    style="-fx-background-color: #16325c; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                </VBox>
            </GridPane>

            <!-- FOOTER -->
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20 0 0 0;">
                <Label text="✈️" style="-fx-font-size: 16px; -fx-text-fill: #666;" />
                <Label text="© 2026 After Travel - Plateforme de gestion de voyages"
                       style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                <Label text="🌍" style="-fx-font-size: 16px; -fx-text-fill: #666;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
