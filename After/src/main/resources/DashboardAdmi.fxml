<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardAdminController"
            fitToWidth="true"
            style="-fx-background-color:#f5f5e8; -fx-background:#f5f5e8;">

    <VBox spacing="30"
          alignment="TOP_CENTER"
          prefWidth="1200"
          style="-fx-padding:40; -fx-background-color:#f5f5e8;">

        <!-- HEADER -->
        <VBox alignment="CENTER_LEFT" spacing="5"
              style="-fx-background-color:white; -fx-background-radius:16;
                     -fx-padding:25 30;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);">
            <Label text="📁 ADMIN DOCUMENT DASHBOARD"
                   style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#1a2744;"/>
            <Label text="Gestion complète des documents de voyage"
                   style="-fx-font-size:13; -fx-text-fill:#94a3b8;"/>
        </VBox>

        <!-- 4 STATS CARDS -->
        <HBox fx:id="statsCard" spacing="20" alignment="CENTER">

            <VBox alignment="CENTER" spacing="8"
                  prefWidth="220" prefHeight="120"
                  style="-fx-background-color:#1a2744;
                         -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(26,39,68,0.35),18,0,0,5);
                         -fx-padding:20;">
                <Label text="📄" style="-fx-font-size:28;"/>
                <Label fx:id="lblTotal" text="0"
                       style="-fx-font-size:32; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Total Documents"
                       style="-fx-font-size:13; -fx-text-fill:#94a3b8;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8"
                  prefWidth="220" prefHeight="120"
                  style="-fx-background-color:#2563eb;
                         -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(37,99,235,0.35),18,0,0,5);
                         -fx-padding:20;">
                <Label text="📂" style="-fx-font-size:28;"/>
                <Label fx:id="lblCategories" text="0"
                       style="-fx-font-size:32; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Catégories"
                       style="-fx-font-size:13; -fx-text-fill:#bfdbfe;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8"
                  prefWidth="220" prefHeight="120"
                  style="-fx-background-color:#f5f5e8;
                         -fx-background-radius:16;
                         -fx-border-color:#1a2744; -fx-border-width:2;
                         -fx-border-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),12,0,0,3);
                         -fx-padding:20;">
                <Label text="⚠️" style="-fx-font-size:28;"/>
                <Label fx:id="lblExpiringSoon" text="0"
                       style="-fx-font-size:32; -fx-font-weight:bold; -fx-text-fill:#1a2744;"/>
                <Label text="Expirent dans 30j"
                       style="-fx-font-size:13; -fx-text-fill:#94a3b8;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8"
                  prefWidth="220" prefHeight="120"
                  style="-fx-background-color:#ef4444;
                         -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(239,68,68,0.35),18,0,0,5);
                         -fx-padding:20;">
                <Label text="❌" style="-fx-font-size:28;"/>
                <Label fx:id="lblExpired" text="0"
                       style="-fx-font-size:32; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Expirés"
                       style="-fx-font-size:13; -fx-text-fill:#fecaca;"/>
            </VBox>

        </HBox>

        <!-- CHARTS -->
        <HBox spacing="25" alignment="CENTER">

            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color:white; -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                         -fx-padding:20;">
                <Label text="📊 Documents par catégorie"
                       style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#1a2744;"/>
                <PieChart fx:id="categoryChart"
                          prefWidth="520" prefHeight="420"
                          legendVisible="true"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color:white; -fx-background-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                         -fx-padding:20;">
                <Label text="📈 Uploads par mois"
                       style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#1a2744;"/>
                <BarChart fx:id="uploadChart"
                          prefWidth="520" prefHeight="420"
                          legendVisible="true">
                    <xAxis><CategoryAxis label="Mois"/></xAxis>
                    <yAxis><NumberAxis label="Uploads"/></yAxis>
                </BarChart>
            </VBox>

        </HBox>

        <!-- CATEGORY MANAGEMENT -->
        <VBox spacing="15" alignment="CENTER"
              style="-fx-background-color:white; -fx-background-radius:16;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                     -fx-padding:25;">

            <Label text="📂 Gestion des catégories"
                   style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#1a2744;"/>

            <HBox spacing="12" alignment="CENTER">
                <TextField fx:id="txtCategorie"
                           promptText="Nom catégorie..."
                           prefWidth="280" prefHeight="40"
                           style="-fx-background-radius:10; -fx-border-radius:10;
                                  -fx-border-color:#e2e8f0; -fx-border-width:2;
                                  -fx-padding:8 12; -fx-font-size:14;
                                  -fx-background-color:#f5f5e8;"/>

                <Button text="➕ Ajouter" onAction="#ajouterCategorie"
                        prefHeight="40"
                        style="-fx-background-color:#2563eb; -fx-text-fill:white;
                               -fx-background-radius:10; -fx-padding:8 20;
                               -fx-font-weight:bold; -fx-font-size:13; -fx-cursor:hand;"/>

                <Button text="✏️ Modifier" onAction="#modifierCategorie"
                        prefHeight="40"
                        style="-fx-background-color:#1a2744; -fx-text-fill:white;
                               -fx-background-radius:10; -fx-padding:8 20;
                               -fx-font-weight:bold; -fx-font-size:13; -fx-cursor:hand;"/>

                <Button text="🗑 Supprimer" onAction="#supprimerCategorie"
                        prefHeight="40"
                        style="-fx-background-color:#ef4444; -fx-text-fill:white;
                               -fx-background-radius:10; -fx-padding:8 20;
                               -fx-font-weight:bold; -fx-font-size:13; -fx-cursor:hand;"/>
            </HBox>

            <ListView fx:id="listCategories"
                      prefWidth="600" prefHeight="150"
                      style="-fx-background-radius:10; -fx-border-radius:10;
                             -fx-border-color:#e2e8f0; -fx-border-width:2;
                             -fx-font-size:14; -fx-background-color:#f5f5e8;"/>

        </VBox>

        <!-- DOCUMENTS EXPIRES -->
        <VBox spacing="12" alignment="CENTER"
              style="-fx-background-color:white; -fx-background-radius:16;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),12,0,0,3);
                     -fx-padding:25;">

            <Label text="❌ Documents expirés"
                   style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#ef4444;"/>

            <ListView fx:id="listExpires"
                      prefWidth="1000" prefHeight="200"
                      style="-fx-background-radius:10; -fx-border-radius:10;
                             -fx-border-color:#fca5a5; -fx-border-width:2;
                             -fx-font-size:13; -fx-background-color:#f5f5e8;"/>

            <Button text="🗑  Supprimer tous les documents expirés"
                    onAction="#supprimerExpires"
                    prefHeight="42"
                    style="-fx-background-color:#ef4444; -fx-text-fill:white;
                           -fx-background-radius:10; -fx-padding:10 30;
                           -fx-font-weight:bold; -fx-font-size:14; -fx-cursor:hand;
                           -fx-effect:dropshadow(gaussian,rgba(239,68,68,0.3),10,0,0,3);"/>

        </VBox>

    </VBox>
</ScrollPane>