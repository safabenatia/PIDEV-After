<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 10;"
      prefWidth="260" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Nom document -->
    <Label fx:id="lblNom"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"
           text="Passeport"/>

    <!-- Catégorie -->
    <Label fx:id="lblCategorie"
           style="-fx-text-fill: #666;"
           text="Document de voyage"/>

    <!-- Dates -->
    <HBox spacing="8">
        <Label text="Ajout:"/>
        <Label fx:id="lblAjout"/>
    </HBox>

    <HBox spacing="8">
        <Label text="Expiration:"/>
        <Label fx:id="lblExpiration"/>
    </HBox>

    <!-- Actions -->
    <HBox spacing="10">
        <Button text="Modifier"/>
        <Button text="Supprimer"
                style="-fx-background-color: #E74C3C; -fx-text-fill: white;"/>
    </HBox>

</VBox>
