<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherDocumentController"
            stylesheets="@/dashboardAdmin.css"
            style="-fx-background-color:#f5f5e8;">

    <!-- ================= NAVBAR ================= -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-background-color:#183a7a; -fx-padding:15 30;">

            <Label text="✈ AFTER Travel"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtSearch"
                       promptText="🔍 Rechercher document..."
                       style="-fx-background-radius:20; -fx-padding:8 15;
                              -fx-pref-width:250; -fx-background-color:white;
                              -fx-border-color:transparent;"/>

            <Button text="📂 Catégories"
                    onAction="#ouvrirCategories"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-border-color:white; -fx-border-radius:20;
                           -fx-background-radius:20; -fx-padding:8 16;
                           -fx-font-weight:bold; -fx-cursor:hand;"/>

            <Button text="➕ Ajouter"
                    onAction="#ouvrirAjout"
                    style="-fx-background-color:white; -fx-text-fill:#183a7a;
                           -fx-background-radius:20; -fx-padding:8 16;
                           -fx-font-weight:bold; -fx-cursor:hand;"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="20" style="-fx-background-color: #1e3a5f; ">
            <padding>
                <Insets top="32" right="16" bottom="32" left="16"/>
            </padding>
            <Label text="After Travel" styleClass="sidebar-title"/>
            <VBox spacing="12">
                <Label text="Mon Profil"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleRetourProfil"
                       style="-fx-cursor: hand;"/>
                <Label text="🗺️ Voyages &amp; Destinations"
                       styleClass="sidebar-btn"
                       onMouseClicked="#handleVoyages"
                       style="-fx-cursor: hand;"
                       fx:id="activitebtn"/>
                <Label text="🏨 Services &amp; Offres"
                       styleClass="sidebar-btn"
                       onMouseClicked="#showser"
                       style="-fx-cursor: hand;"
                       fx:id="servicesBtn"/>

                <Label text="🏄 Activite "
                       styleClass="sidebar-btn"
                       onMouseClicked="#showact"
                       style="-fx-cursor: hand;"
                       fx:id="actbtn"/>
                <Label text="📝 Document " style="-fx-text-fill:#FFD700; -fx-font-size:14px; -fx-cursor:hand; -fx-font-weight:bold;"/>
                <Label text="🎟️ Reservation "
                       styleClass="sidebar-btn"
                       onMouseClicked="#showres"
                       style="-fx-cursor: hand;"
                       fx:id="resbtn"/>
                <Label text="💸 Depenses"
                       styleClass="sidebar-btn"
                       onMouseClicked="#showDepense"
                       style="-fx-cursor: hand;"
                       fx:id="Depensebtn"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" styleClass="sidebar-logout" onAction="#handleLogout"/>
        </VBox>
    </left>
    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:#f5f5e8; -fx-background:#f5f5e8;">
            <VBox fx:id="containerDocuments"
                  spacing="20"
                  alignment="TOP_CENTER"
                  style="-fx-padding:30; -fx-background-color:#f5f5e8;"/>
        </ScrollPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color:#183a7a; -fx-padding:12;">
            <Label text="© 2026 AFTER Travel - Gestion Documents Voyage"
                   style="-fx-text-fill:white; -fx-font-size:13;"/>
        </HBox>
    </bottom>

</BorderPane>