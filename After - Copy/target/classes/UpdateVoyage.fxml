<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UpdateVoyageController">

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background:#F5F5DC; -fx-background-color:#F5F5DC;">
        <content>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding:40; -fx-background-color:#F5F5DC;">
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@images/Blue and Yellow Illustrative Travel Agency Logo - 1.png" />
            </image>
         </ImageView>

            <Label style="-fx-font-size:18px;" text="Modifier Voyage" textFill="#16325c" />

            <TextField fx:id="idField" promptText="ID Voyage" />

            <TextField fx:id="titreField" promptText="Titre" />
            <TextField fx:id="descriptionField" promptText="Description" />
            <TextField fx:id="prixField" promptText="Prix" />
            <TextField fx:id="nbPlacesField" promptText="Nombre Places" />
            <TextField fx:id="imageField" promptText="Image sélectionnée"/>
            <Button text="Choisir Image" onAction="#chooseImage"/>
            <TextField fx:id="idDestinationField" promptText="ID Destination" />

            <Button onAction="#updateVoyage" style="-fx-background-color: #16325c;" text=" Modifier voyage" textFill="WHITE" />
            <Button onAction="#goBack" style="-fx-background-color: #16325c;" text="Retour" textFill="WHITE" />

        </VBox>
        </content>
        </ScrollPane>
    </center>

</BorderPane>
